# Docker 部署前必须设置，建议至少 16 个字符。
PANEL_PASSWORD=
# 服务器访问端口
PANEL_PORT=8787
# 默认使用固定版本；跟随最新版可设置为 gongjuren8856/cloudreel:latest。
CLOUDREEL_IMAGE=gongjuren8856/cloudreel:1.0.0
# 以下仅在直接用 Node 启动时使用；Docker 已设置这些路径。
HOST=127.0.0.1
PORT=8787
RCLONE_BIN=rclone
RCLONE_CONFIG=./data/config/rclone.conf
DATA_DIR=./data/panel
LOCAL_ROOT=./data/files
# HTTPS 反向代理时设为 true；直接使用 HTTP 时保持 false。
COOKIE_SECURE=false
# Docker 配套 OpenList 的首次初始化密码，建议独立的 16 位以上随机密码。
OPENLIST_ADMIN_PASSWORD=
# 以下仅供直接 Node 启动或连接已有实例；Docker 使用内部服务地址。
OPENLIST_URL=
OPENLIST_ADMIN_USER=admin
OPENLIST_ADMIN_TOKEN=
